DATABASE_URL=postgresql+psycopg2://clinic:clinic@localhost:5432/clinic_db

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

LLM_API_KEY=
# Optional — up to 5 more Groq API keys to round-robin across (see app.core.api_keys).
LLM_API_KEY_2=
LLM_API_KEY_3=
LLM_API_KEY_4=
LLM_API_KEY_5=
LLM_API_KEY_6=
LLM_PROVIDER=groq
GROQ_HELPER_MODEL=openai/gpt-oss-20b

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Clinic-Management-System

CHROMA_PATH=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8001
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Optional — Hugging Face Inference API token (raises rate limits; required if the model is gated).
HF_TOKEN=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=QuickCheck Clinic

DEFAULT_SLOT_MINUTES=30
RETRIEVAL_SIMILARITY_THRESHOLD=0.5
